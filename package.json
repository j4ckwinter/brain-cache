{
  "name": "brain-cache",
  "version": "4.2.0",
  "description": "Local MCP-first context engine for Claude. Index your codebase, retrieve only what matters, and cut token usage.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "brain-cache": "./dist/cli.js"
  },
  "files": [
    "dist/",
    ".claude/skills/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/j4ckwinter/brain-cache",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j4ckwinter/brain-cache.git"
  },
  "bugs": {
    "url": "https://github.com/j4ckwinter/brain-cache/issues"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "postbuild": "node scripts/copy-wasm.mjs dist/wasm",
    "prepare": "npm run build",
    "link": "npm link",
    "pretest": "node scripts/copy-wasm.mjs src/services/wasm",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist": "node scripts/verify-dist.mjs",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:distribution": "vitest run --config vitest.distribution.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@lancedb/lancedb": "^0.39.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "apache-arrow": "18.1.0",
    "commander": "15.0.0",
    "dedent": "^1.7.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "marked": "^18.0.14",
    "ollama": "^0.6.3",
    "pino": "^10.3.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "~0.25.10",
    "zod": "^4.6.7"
  },
  "overrides": {
    "apache-arrow": "18.1.0",
    "@huggingface/transformers": "3.8.1",
    "sharp": "0.35.5",
    "@hono/node-server": "2.1.6",
    "hono": "4.13.17",
    "fast-uri": "4.2.3",
    "express-rate-limit": "8.7.0",
    "ip-address": "10.7.6",
    "body-parser": "2.4.0",
    "qs": "6.17.1",
    "tsup": {
      "esbuild": "^0.28.2"
    }
  },
  "devDependencies": {
    "@types/dedent": "^0.7.2",
    "@types/node": "^22.0.0",
    "cpy-cli": "^7.0.0",
    "pino-pretty": "^11.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "ai",
    "rag",
    "claude",
    "mcp",
    "embeddings",
    "developer-tools",
    "ollama"
  ]
}
